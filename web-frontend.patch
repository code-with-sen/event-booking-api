@@ -0,0 +1,173 @@
+import { useEffect, useState, type ReactNode } from 'react';
+import { api } from './api';
+import { useAuth } from './auth';
+import { EventPage } from './pages/EventPage';
+import { HomePage } from './pages/HomePage';
+import { LoginPage } from './pages/LoginPage';
+import { MyBookingsPage } from './pages/MyBookingsPage';
+import { NewEventPage } from './pages/NewEventPage';
+import { RacePage } from './pages/RacePage';
+import { loginPath, useRoute, type Route } from './router';
+
+const REPO_URL = 'https://github.com/code-with-sen/event-booking-api';
+
+type ServerState = 'checking' | 'waking' | 'up' | 'down';
+
+/** The demo API sleeps on Render's free tier, so tell visitors when the first request is slow. */
+function useServerState() {
+  const [state, setState] = useState<ServerState>('checking');
+  useEffect(() => {
+    let done = false;
+    const slow = setTimeout(() => !done && setState('waking'), 2500);
+    const attempt = async (triesLeft: number): Promise<void> => {
+      try {
+        await api.health();
+        done = true;
+        setState('up');
+      } catch {
+        if (triesLeft > 0) {
+          setState('waking');
+          await new Promise((r) => setTimeout(r, 5000));
+          return attempt(triesLeft - 1);
+        }
+        done = true;
+        setState('down');
+      }
+    };
+    attempt(12);
+    return () => clearTimeout(slow);
+  }, []);
+  return state;
+}
+
+function NavLink({ href, active, children }: { href: string; active: boolean; children: ReactNode }) {
+  return (
+    <a href={href} className={active ? 'nav-link active' : 'nav-link'} aria-current={active ? 'page' : undefined}>
+      {children}
+    </a>
+  );
+}
+
+function Header({ route }: { route: Route }) {
+  const { user, signOut } = useAuth();
+  return (
+    <header className="header">
+      <div className="container header-inner">
+        <a href="#/" className="brand">
+          <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
+            <rect width="32" height="32" rx="8" fill="currentColor" />
+            <path d="M8 11h16v3a2 2 0 0 0 0 4v3H8v-3a2 2 0 0 0 0-4z" fill="var(--bg)" />
+          </svg>
+          <span>Event Booking</span>
+        </a>
+        <nav className="nav">
+          <NavLink href="#/" active={route.name === 'home' || route.name === 'event'}>
+            Events
+          </NavLink>
+          <NavLink href="#/race" active={route.name === 'race'}>
+            Race demo
+          </NavLink>
+          {user && (
+            <>
+              <NavLink href="#/bookings" active={route.name === 'bookings'}>
+                My bookings
+              </NavLink>
+              <NavLink href="#/events/new" active={route.name === 'new-event'}>
+                New event
+              </NavLink>
+            </>
+          )}
+        </nav>
+        <div className="header-user">
+          {user ? (
+            <>
+              <span className="user-name" title={user.email}>
+                {user.name}
+              </span>
+              <button className="btn btn-ghost btn-sm" onClick={signOut}>
+                Sign out
+              </button>
+            </>
+          ) : (
+            route.name !== 'login' && (
+              <a className="btn btn-primary btn-sm" href={loginPath()}>
+                Sign in
+              </a>
+            )
+          )}
+        </div>
+      </div>
+    </header>
+  );
+}
+
+function ServerBanner({ state }: { state: ServerState }) {
+  if (state === 'waking')
+    return (
+      <div className="banner banner-warn" role="status">
+        <span className="spinner" aria-hidden="true" /> Waking up the API server. On the free tier this can take up to a
+        minute after a quiet spell.
+      </div>
+    );
+  if (state === 'down')
+    return (
+      <div className="banner banner-error" role="alert">
+        The API isn't responding right now. Try refreshing in a minute.
+      </div>
+    );
+  return null;
+}
+
+export function App() {
+  const route = useRoute();
+  const server = useServerState();
+
+  let page: ReactNode;
+  switch (route.name) {
+    case 'home':
+      page = <HomePage />;
+      break;
+    case 'event':
+      page = <EventPage key={route.id} id={route.id} />;
+      break;
+    case 'new-event':
+      page = <NewEventPage />;
+      break;
+    case 'bookings':
+      page = <MyBookingsPage />;
+      break;
+    case 'login':
+      page = <LoginPage next={route.next} />;
+      break;
+    case 'race':
+      page = <RacePage />;
+      break;
+    default:
+      page = (
+        <div className="empty">
+          <h1>Page not found</h1>
+          <a href="#/">Back to events</a>
+        </div>
+      );
+  }
+
+  return (
+    <>
+      <Header route={route} />
+      <ServerBanner state={server} />
+      <main className="container main">{page}</main>
+      <footer className="footer container">
+        <span>
+          Frontend for the{' '}
+          <a href={REPO_URL} target="_blank" rel="noreferrer">
+            event-booking-api
+          </a>{' '}
+          (TypeScript, Express, PostgreSQL)
+        </span>
+        <a href={REPO_URL} target="_blank" rel="noreferrer">
+          View source
+        </a>
+      </footer>
+    </>
+  );
+}
diff --git a/web/src/api.ts b/web/src/api.ts
new file mode 100644
index 0000000..47b310e
--- /dev/null
+++ b/web/src/api.ts
@@ -0,0 +1,139 @@
+// Thin typed client for the Event Booking API.
+
+export const API_URL = (import.meta.env.VITE_API_URL ?? '').replace(/\/$/, '');
+
+export interface User {
+  id: number;
+  email: string;
+  name: string;
+}
+
+export interface Event {
+  id: number;
+  organizerId: number;
+  title: string;
+  description: string;
+  venue: string;
+  startsAt: string;
+  capacity: number;
+  seatsBooked: number;
+  seatsAvailable: number;
+}
+
+export interface Booking {
+  id: number;
+  eventId: number;
+  userId: number;
+  seats: number;
+  status: 'confirmed' | 'cancelled';
+  createdAt: string;
+  cancelledAt: string | null;
+}
+
+export interface MyBooking {
+  id: number;
+  seats: number;
+  status: 'confirmed' | 'cancelled';
+  createdAt: string;
+  cancelledAt: string | null;
+  event: { id: number; title: string; venue: string; startsAt: string };
+}
+
+export interface Attendee {
+  id: number;
+  seats: number;
+  status: 'confirmed' | 'cancelled';
+  createdAt: string;
+  userId: number;
+  userName: string;
+  userEmail: string;
+}
+
+export interface Paginated<T> {
+  data: T[];
+  pagination: { total: number; limit: number; offset: number };
+}
+
+export class ApiError extends Error {
+  constructor(
+    public status: number,
+    public code: string,
+    message: string,
+    public details?: { path: string; message: string }[],
+  ) {
+    super(message);
+  }
+}
+
+export async function request<T>(
+  path: string,
+  options: { method?: string; body?: unknown; token?: string | null } = {},
+): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (options.body !== undefined) headers['Content-Type'] = 'application/json';
+  if (options.token) headers.Authorization = `Bearer ${options.token}`;
+
+  let res: Response;
+  try {
+    res = await fetch(`${API_URL}${path}`, {
+      method: options.method ?? 'GET',
+      headers,
+      body: options.body !== undefined ? JSON.stringify(options.body) : undefined,
+    });
+  } catch {
+    throw new ApiError(0, 'NETWORK_ERROR', 'Could not reach the API. It may be waking up, try again in a moment.');
+  }
+
+  if (res.status === 204) return undefined as T;
+  const json = await res.json().catch(() => null);
+  if (!res.ok) {
+    const err = json?.error;
+    throw new ApiError(res.status, err?.code ?? 'ERROR', err?.message ?? `Request failed (${res.status})`, err?.details);
+  }
+  return json as T;
+}
+
+type Token = string | null;
+
+export const api = {
+  health: () => request<{ status: string; database: string }>('/health'),
+
+  register: (body: { email: string; name: string; password: string }) =>
+    request<{ user: User; token: string }>('/api/v1/auth/register', { method: 'POST', body }),
+  login: (body: { email: string; password: string }) =>
+    request<{ user: User; token: string }>('/api/v1/auth/login', { method: 'POST', body }),
+  me: (token: Token) => request<{ user: User }>('/api/v1/auth/me', { token }),
+
+  listEvents: (params: { q?: string; limit?: number; offset?: number; includePast?: boolean }) => {
+    const qs = new URLSearchParams();
+    if (params.q) qs.set('q', params.q);
+    if (params.limit) qs.set('limit', String(params.limit));
+    if (params.offset) qs.set('offset', String(params.offset));
+    if (params.includePast) qs.set('includePast', 'true');
+    return request<Paginated<Event>>(`/api/v1/events?${qs}`);
+  },
+  getEvent: (id: number) => request<{ event: Event }>(`/api/v1/events/${id}`),
+  createEvent: (
+    token: Token,
+    body: { title: string; description: string; venue: string; startsAt: string; capacity: number },
+  ) => request<{ event: Event }>('/api/v1/events', { method: 'POST', body, token }),
+  deleteEvent: (token: Token, id: number) => request<void>(`/api/v1/events/${id}`, { method: 'DELETE', token }),
+  attendees: (token: Token, id: number) => request<{ data: Attendee[] }>(`/api/v1/events/${id}/bookings`, { token }),
+
+  book: (token: Token, eventId: number, seats: number) =>
+    request<{ booking: Booking }>(`/api/v1/events/${eventId}/bookings`, { method: 'POST', body: { seats }, token }),
+  myBookings: (token: Token) => request<{ data: MyBooking[] }>('/api/v1/bookings/me', { token }),
+  cancel: (token: Token, bookingId: number) =>
+    request<{ booking: Booking }>(`/api/v1/bookings/${bookingId}/cancel`, { method: 'POST', token }),
+};
+
+export function formatDate(iso: string) {
+  return new Date(iso).toLocaleString(undefined, {
+    weekday: 'short',
+    day: 'numeric',
+    month: 'short',
+    year: 'numeric',
+    hour: 'numeric',
+    minute: '2-digit',
+  });
+}
