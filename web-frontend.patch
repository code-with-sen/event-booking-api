+  font-size: 0.85rem;
+  margin-top: 6px;
+  font-weight: 500;
+}
+.meter-full .meter-label span:first-child {
+  color: var(--danger);
+}
+
+/* Event page */
+.event-layout {
+  display: grid;
+  grid-template-columns: 1fr 320px;
+  gap: 28px;
+  align-items: start;
+}
+@media (max-width: 820px) {
+  .event-layout {
+    grid-template-columns: 1fr;
+  }
+}
+.event-title {
+  font-size: 2rem;
+  overflow-wrap: anywhere;
+}
+.event-venue-lg {
+  font-size: 1.05rem;
+  color: var(--muted);
+}
+.event-description {
+  white-space: pre-wrap;
+  margin: 16px 0;
+}
+.book-card h2 {
+  margin-bottom: 14px;
+}
+.book-card .field {
+  margin-bottom: 14px;
+}
+.organizer {
+  margin-top: 28px;
+}
+.table-wrap {
+  overflow-x: auto;
+}
+.table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.9rem;
+}
+.table th,
+.table td {
+  text-align: left;
+  padding: 9px 10px;
+  border-bottom: 1px solid var(--border);
+  white-space: nowrap;
+}
+.table th {
+  color: var(--muted);
+  font-weight: 600;
+  font-size: 0.8rem;
+}
+.table .num {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+/* Bookings */
+.booking-list {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.booking-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+  padding: 16px 20px;
+}
+.booking-row p {
+  margin: 0;
+  font-size: 0.9rem;
+}
+.booking-row.is-cancelled .booking-title {
+  color: var(--muted);
+}
+.booking-title {
+  font-weight: 600;
+  font-size: 1.02rem;
+}
+.booking-meta {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+/* Auth */
+.auth {
+  max-width: 420px;
+  padding-top: 20px;
+}
+.auth .card {
+  margin-bottom: 14px;
+}
+.tabs {
+  display: flex;
+  background: var(--surface-2);
+  border-radius: 10px;
+  padding: 4px;
+  margin-bottom: 20px;
+}
+.tab {
+  flex: 1;
+  font: inherit;
+  font-weight: 600;
+  border: 0;
+  background: none;
+  color: var(--muted);
+  padding: 8px;
+  border-radius: 8px;
+  cursor: pointer;
+}
+.tab.active {
+  background: var(--surface);
+  color: var(--text);
+  box-shadow: var(--shadow);
+}
+
+/* Race demo */
+.race-head {
+  max-width: 720px;
+  margin-bottom: 20px;
+}
+.race-controls {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-bottom: 20px;
+}
+.race-controls .field-row .field {
+  max-width: 200px;
+}
+.race-controls .btn-lg {
+  align-self: flex-start;
+}
+.race-stats {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 12px;
+  margin-bottom: 14px;
+}
+@media (max-width: 720px) {
+  .race-stats {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+.stat {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 14px 16px;
+  display: flex;
+  flex-direction: column;
+}
+.stat-value {
+  font-size: 1.6rem;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+}
+.stat-won {
+  color: var(--ok);
+}
+.stat-lost {
+  color: var(--danger);
+}
+.stat-label {
+  color: var(--muted);
+  font-size: 0.82rem;
+}
+.verdict {
+  border-radius: var(--radius);
+  padding: 14px 18px;
+  margin-bottom: 14px;
+}
+.verdict-ok {
+  background: var(--ok-soft);
+  color: var(--ok);
+}
+.verdict-bad {
+  background: var(--danger-soft);
+  color: var(--danger);
+}
+.verdict .meter-label {
+  color: inherit;
+}
+.verdict-link {
+  display: inline-block;
+  margin-top: 10px;
+  color: inherit;
+  font-weight: 600;
+}
+.tiles {
+  list-style: none;
+  padding: 0;
+  margin: 0 0 28px;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
+  gap: 8px;
+}
+.tile {
+  border: 1px solid var(--border);
+  background: var(--surface);
+  border-radius: 10px;
+  padding: 10px 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  transition: background 0.2s, border-color 0.2s;
+}
+.tile-buyer {
+  font-size: 0.78rem;
+  color: var(--muted);
+}
+.tile-result {
+  font-weight: 700;
+  font-size: 0.95rem;
+}
+.tile-ms {
+  font-size: 0.75rem;
+  color: var(--muted);
+  font-variant-numeric: tabular-nums;
+}
+.tile-pending {
+  animation: pulse 1s ease-in-out infinite;
+}
+@keyframes pulse {
+  50% {
+    border-color: var(--accent);
+  }
+}
+.tile-won {
+  background: var(--ok-soft);
+  border-color: var(--ok);
+}
+.tile-won .tile-result {
+  color: var(--ok);
+}
+.tile-lost {
+  background: var(--danger-soft);
+  border-color: transparent;
+}
+.tile-lost .tile-result,
+.tile-error .tile-result {
+  color: var(--danger);
+}
+.tile-error {
+  border-color: var(--danger);
+}
+.explain pre {
+  background: var(--surface-2);
+  border-radius: 10px;
+  padding: 14px 16px;
+  overflow-x: auto;
+  line-height: 1.5;
+}
+@media (prefers-reduced-motion: reduce) {
+  * {
+    animation: none !important;
+    transition: none !important;
+  }
+}
+.verdict .meter-fill {
+  background: currentColor;
+}
+.verdict .meter-label span {
+  color: inherit;
+}
